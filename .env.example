# Copy to .env and fill in. Never commit real values.

# --- Server ---
# Optional. HTTP port (default: 5000)
PORT=5000

# --- Database (Neon Postgres) ---
# Used by the app and by drizzle-kit
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (JWT) ---
# Required. Must match the JWT_SECRET used by TBH-Client to sign visitor tokens
JWT_SECRET=
# Optional. Token lifetime in seconds (default: 3600)
JWT_EXPIRATION=3600

# --- Firebase Admin (project: tuhogarboreal) ---
# Service account credentials. Keep PRIVATE_KEY on one line with literal \n for newlines
CLIENT_EMAIL=
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Mercado Pago ---
# Server-side access token (not the public key)
ML_ACCESS_TOKEN=

# --- Admin ---
# Admin ID recorded as createdBy/updatedBy by the _dev/createProducts seeding endpoint
MASTER_ADMIN_ID=

# --- Payments ---
# Tax rate as a fraction (default 0.19). Owned by the server
TAX_RATE=0.19
# Secret shown in the Mercado Pago dashboard after registering the webhook
MP_WEBHOOK_SECRET=
# Public base URL of this API (used as notification_url), e.g. https://api.tuhogarboreal.com
API_PUBLIC_URL=
